{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunny",
  "version": "1.0.1",
  "identifier": "app.sunny.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aliplfrh/sunny/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3Mjk0MzhDNTE2MjNGMkMKUldRc1AySlJqRU1wNStMVGFlZUJpbElTL3V2Nkg0RC83S2lZdE9IUE4wS2U3dDBWV3RhTXdnRG8K"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sunny",
        "width": 720,
        "height": 464,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "index.html?window=settings",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
